<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".eceactivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/emad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:columnCount="1"
            android:rowCount="6">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#09729C"
                android:elevation="20dp"
                android:onClick="electromagneticsmod1">

                <ImageView
                    android:id="@+id/m1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m1"
                    android:layout_marginStart="10dp"
                    android:text="Module 1"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Vector Analysis"
                    android:textColor="@color/black"
                    android:textSize="40dp"></TextView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#5CC545"
                android:elevation="20dp"
                android:onClick="electromagneticsmod2">

                <ImageView
                    android:id="@+id/m2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m2"
                    android:layout_marginStart="10dp"
                    android:text="Module 2"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="276dp"
                    android:layout_height="77dp"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Electrostatics"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="40dp"></TextView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#CCA51C"
                android:elevation="20dp"
                android:onClick="electromagneticsmod3">

                <ImageView
                    android:id="@+id/m3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m3"
                    android:layout_marginStart="10dp"
                    android:text="Module 3"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Electric Fields in Matter"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="34sp"></TextView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#09729C"
                android:elevation="20dp"
                android:onClick="electromagneticsmod4">

                <ImageView
                    android:id="@+id/m4"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m4"
                    android:layout_marginStart="10dp"
                    android:text="Module 4"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="269dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Potentials"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="40dp"></TextView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#CC1C4E"
                android:elevation="20dp"
                android:onClick="electromagneticsmod5">

                <ImageView
                    android:id="@+id/m5"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m5"
                    android:layout_marginStart="10dp"
                    android:text="Module 5"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Magnetostatics"
                    android:textColor="@color/black"
                    android:textSize="40dp"></TextView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_margin="10dp"
                android:background="#CCA51C"
                android:elevation="20dp"
                android:onClick="electromagneticsmod6">

                <ImageView
                    android:id="@+id/m6"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/baselinefolder"></ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/m6"
                    android:layout_marginStart="10dp"
                    android:text="Module 6"
                    android:textColor="@color/black"
                    android:textSize="20dp"></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="20dp"
                    android:text="Magnetic Fields in Matter"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="34sp"></TextView>
            </RelativeLayout>
        </GridLayout>
    </ScrollView>
    <com.google.android.gms.ads.AdView
        android:id="@+id/emad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="46dp"
        app:adSize="BANNER"
        app:adUnitId="@string/dashboardad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>