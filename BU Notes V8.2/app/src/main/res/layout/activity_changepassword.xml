<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".ForgotPasswordActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/custom">

                <TextView
                    android:id="@+id/textView_password_reset_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp"
                    android:text="Change Password"
                    android:textAlignment="center"
                    android:textSize="40dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView_password_reset_head"
                    android:text="** Change password will only work if account is verified** "
                    android:textColor="@color/black"
                    android:textColorHighlight="#FD0303"
                    android:textAlignment="center"></TextView>


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="15dp"
                android:background="#979D9F"
                android:padding="15dp">




                <EditText
                    android:id="@+id/CurrentPassword"
                    android:layout_width="300dp"
                    android:layout_height="50dp"
                    android:hint="  Current Password *"
                    android:textColorHint="@color/black"
                    android:layout_marginStart="18dp"
                    android:inputType="textPassword"
                    android:drawableStart="@drawable/baseline_lock_open_24"
                    android:textColor="@color/black"
                    ></EditText>

                <EditText
                    android:id="@+id/NewPassword"
                    android:layout_width="300dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="18dp"
                    android:drawableStart="@drawable/baseline_lock_24_2"
                    android:hint="  New Password *"
                    android:textColor="@color/black"
                    android:inputType="textPassword"
                    android:layout_below="@id/CurrentPassword"
                    android:textColorHint="@color/black"></EditText>

                <EditText
                    android:id="@+id/ConfirmPassword"
                    android:layout_width="300dp"
                    android:layout_height="50dp"
                    android:layout_below="@id/NewPassword"
                    android:layout_marginStart="18dp"
                    android:drawableStart="@drawable/baseline_lock_24_2"
                    android:hint="  Confirm Password *"
                    android:inputType="textPassword"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"></EditText>

                <Button
                    android:id="@+id/ChangePassword"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ConfirmPassword"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:onClick="changepass"
                    android:text="Save Password"
                    android:textColor="@color/black" />

            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>